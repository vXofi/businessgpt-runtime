# Key reference only. Production uses two private mode-0600 files:
# /opt/businessgpt/api.env and /opt/businessgpt-bot/bot.env.
# Required secrets and identity allowlists are deliberately blank.

# BusinessGPT API
BUSINESSGPT_API_KEY=
BUSINESSGPT_MODEL_PATH=/models/model-Q5_K_M-no-mtp.gguf
BUSINESSGPT_MMPROJ_PATH=/models/mmproj-businessgpt-v16-f16.gguf
BUSINESSGPT_MODEL_MANIFEST_PATH=/app/model-manifest.json
BUSINESSGPT_ALLOW_UNVERIFIED_MODEL=false
BUSINESSGPT_N_CTX=4096
BUSINESSGPT_CONTEXT_SAFETY_TOKENS=16
BUSINESSGPT_IMAGE_MAX_TOKENS=1024
BUSINESSGPT_N_THREADS=8
BUSINESSGPT_N_GPU_LAYERS=0
BUSINESSGPT_N_PARALLEL=1
BUSINESSGPT_STARTUP_TIMEOUT_SECONDS=900
BUSINESSGPT_TOKENIZE_TIMEOUT_SECONDS=30
BUSINESSGPT_GENERATION_TIMEOUT_SECONDS=300
BUSINESSGPT_HEALTH_TIMEOUT_SECONDS=2
BUSINESSGPT_MAX_REQUEST_BODY_BYTES=16777216
BUSINESSGPT_IMAGE_DECODE_CONCURRENCY=1

# BusinessGPT Telegram bot
BUSINESSGPT_BOT_TOKEN=
BUSINESSGPT_BOT_OWNER_USER_IDS=
BUSINESSGPT_BOT_ALLOWED_CHAT_IDS=
BUSINESSGPT_BOT_TELEGRAM_PROXY_URL=socks5://businessgpt-xray:1080
BUSINESSGPT_API_URL=http://businessgpt-api:8000/generate
BUSINESSGPT_BOT_ALLOWED_API_URLS=http://businessgpt-api:8000/generate
BUSINESSGPT_BOT_DB_PATH=/data/bot.sqlite3
BUSINESSGPT_BOT_MEDIA_CACHE_DIR=/data/pending-media
BUSINESSGPT_BOT_MEDIA_CACHE_TTL_SECONDS=86400
BUSINESSGPT_BOT_MEDIA_CACHE_MAX_BYTES=268435456
BUSINESSGPT_BOT_IMAGE_MAX_BYTES=10485760
BUSINESSGPT_BOT_FEEDBACK_PUBLIC_KEY_B64=
BUSINESSGPT_BOT_RECENT_CONTEXT_MESSAGES=10
BUSINESSGPT_BOT_CONTEXT_MAX_CHATS=64
BUSINESSGPT_BOT_CONTEXT_TTL_SECONDS=21600
BUSINESSGPT_BOT_MAX_CONCURRENT_GENERATIONS=1
BUSINESSGPT_BOT_GENERATION_QUEUE_SIZE=8
# Defaults for groups without an explicit /settings override.
BUSINESSGPT_BOT_RATE_USER_REQUESTS=3
BUSINESSGPT_BOT_RATE_CHAT_REQUESTS=10
# Shared window length; worker and queue capacity remain server-level settings.
BUSINESSGPT_BOT_RATE_WINDOW_SECONDS=60
BUSINESSGPT_BOT_PENDING_ACTION_TTL_SECONDS=900
BUSINESSGPT_BOT_FEEDBACK_UNREACTED_TTL_SECONDS=604800
BUSINESSGPT_BOT_FEEDBACK_UNREACTED_MAX_ROWS=5000
BUSINESSGPT_BOT_FEEDBACK_UNREACTED_MAX_BYTES=536870912
BUSINESSGPT_BOT_FEEDBACK_REACTED_MAX_ROWS=50000
BUSINESSGPT_BOT_FEEDBACK_REACTED_MAX_BYTES=4294967296
BUSINESSGPT_BOT_FEEDBACK_MEDIA_MAX_BYTES=2147483648
BUSINESSGPT_BOT_MAX_TOKENS=128
BUSINESSGPT_BOT_TEMPERATURE=0.9
BUSINESSGPT_BOT_TOP_P=0.9
BUSINESSGPT_BOT_TOP_K=50
BUSINESSGPT_BOT_REPETITION_PENALTY=1.2
